---
import Input from '@/components/ui/Input.astro'
import McLovinCanvas from '@/components/McLovinCanvas.astro'
import Select from '@/components/ui/Select.astro'
import TakePhoto from '@/components/TakePhoto.astro'
import Sign from '@/components/Sign.astro'
import Button from '@/components/ui/Button.astro'
import Download from '@/icons/download.astro'
import type { CreateIdTranslations } from '@/i18n/translations'

interface Props {
  t: CreateIdTranslations
}

const { t } = Astro.props
---

<section
  id="createid-section"
  class="bg-hawaii-navy py-16"
  data-feedback={JSON.stringify(t.feedback)}
>
  <div class="mx-auto w-full max-w-screen-lg px-4 md:px-6">

    <!-- Section header -->
    <div data-animate class="opacity-0 animate-fade-in text-center mb-10">
      <span class="inline-block text-xs tracking-[0.3em] uppercase text-hawaii-blue-light border border-hawaii-steel rounded-full px-3 py-1 mb-4">
        {t.badge}
      </span>
      <h2 class="text-3xl font-bold text-hawaii-gold-light mt-3">
        {t.title}
      </h2>
      <p class="text-slate-400 mt-2">
        {t.subtitle}
      </p>
    </div>

    <!-- Main layout: form left, canvas right on desktop; form on top on mobile -->
    <div class="flex flex-col-reverse md:flex-row gap-6 mb-8">

      <!-- Canvas / Preview column -->
      <div data-animate class="opacity-0 animate-scale-in w-full md:w-auto flex flex-col items-center gap-4">
        <!-- Interactive canvas -->
        <McLovinCanvas label={t.canvasLabel} />

        <!-- Botón flip, visible solo en md+ (donde el canvas es visible) -->
        <Button
          id="flipCard"
          color="info"
          variant="outlined"
          size="sm"
          class="hidden md:inline-flex"
          data-front={t.flipFront}
          data-back={t.flipBack}
        >
          {t.flipBack}
        </Button>
      </div>

      <!-- Form column -->
      <form id="form" class="w-full">
        <div data-animate class="opacity-0 animate-slide-up" style="animation-delay: 0ms">
          <Input id="name" label={t.name} class="mb-5" maxlength="15" />
        </div>
        <div data-animate class="opacity-0 animate-slide-up" style="animation-delay: 100ms">
          <div class="flex gap-3 mb-5">
            <Input id="dob" type="date" label={t.dob} class="flex-1 min-w-0" min="1900-01-01" />
            <Select id="sex" label={t.genre} placeholder={t.genrePlaceholder} options={t.genres} class="flex-1 min-w-0" />
          </div>
        </div>
        <div data-animate class="opacity-0 animate-slide-up" style="animation-delay: 200ms">
          <TakePhoto t={t.photo} />
        </div>
        <div data-animate class="opacity-0 animate-slide-up" style="animation-delay: 300ms">
          <Sign t={t.sign} />
        </div>
      </form>

    </div>

    <!-- Export button -->
    <div class="flex flex-col items-center gap-3">
      <label class="flex items-center gap-2 cursor-pointer select-none text-slate-400 text-sm">
        <input
          id="exportBothSides"
          type="checkbox"
          class="w-4 h-4 rounded accent-hawaii-gold-light cursor-pointer"
        />
        {t.exportBothSides}
      </label>
      <Button
        id="exportCanvas"
        size="lg"
        class="min-w-48"
        aria-describedby="exportDisclaimer"
        data-flipped-hint={t.exportDisabledFlipped}
      >
        {t.export}
        <Download />
      </Button>
      <p id="exportDisclaimer" class="max-w-md text-center text-sm text-slate-400 text-pretty mt-2">
        {t.disclaimer}
      </p>
    </div>
  </div>
</section>

<script>
  import { $ } from '@/utils/domSelector'
  import { notify } from '@/utils/toast'
  import type { ExportFeedbackTranslations } from '@/i18n/translations'
  import JSZip from 'jszip'

  const $section = $('#createid-section')
  const $canvas = $<HTMLCanvasElement>('#mclovin-canvas')
  const $exportCanvasButton = $<HTMLButtonElement>('#exportCanvas')
  const $exportBothSides = $<HTMLInputElement>('#exportBothSides')
  const $flipContainer = document.getElementById('flip-container')
  const $dob = $<HTMLInputElement>('#dob')

  const feedback = JSON.parse($section.dataset.feedback ?? '{}') as ExportFeedbackTranslations

  // No future birthdays; set here so a static build doesn't freeze the date
  const today = new Date()
  $dob.max = [
    today.getFullYear(),
    String(today.getMonth() + 1).padStart(2, '0'),
    String(today.getDate()).padStart(2, '0'),
  ].join('-')

  let isExporting = false

  function download(href: string, filename: string): void {
    const anchor = document.createElement('a')
    anchor.href = href
    anchor.download = filename
    // Firefox ignores clicks on detached anchors
    anchor.style.display = 'none'
    document.body.appendChild(anchor)
    anchor.click()
    anchor.remove()
  }

  function canvasToBlob(): Promise<Blob> {
    return new Promise((resolve, reject) => {
      $canvas.toBlob((blob) => {
        if (blob) resolve(blob)
        else reject(new Error('Canvas export returned no data'))
      }, 'image/png')
    })
  }

  function downloadBlob(blob: Blob, filename: string): void {
    const objectUrl = URL.createObjectURL(blob)
    download(objectUrl, filename)
    // Revoking right away can cancel the download in Safari and Firefox
    setTimeout(() => URL.revokeObjectURL(objectUrl), 10_000)
  }

  async function exportFrontOnly(): Promise<void> {
    downloadBlob(await canvasToBlob(), 'my-mclovin-id.png')
  }

  async function exportZip(): Promise<void> {
    const zip = new JSZip()
    zip.file('mclovin-id-front.png', await canvasToBlob())

    let backSkipped = false
    try {
      const res = await fetch('/images/mclovin-id-back.webp')
      if (!res.ok) throw new Error(`HTTP ${res.status}`)
      zip.file('mclovin-id-back.webp', await res.arrayBuffer())
    } catch {
      backSkipped = true
    }

    const blob = await zip.generateAsync({ type: 'blob' })
    downloadBlob(blob, 'my-mclovin-id.zip')

    if (backSkipped) {
      notify({ type: 'warning', title: feedback.backSkippedTitle, message: feedback.backSkippedMessage })
    }
  }

  function setExportDisabled(disabled: boolean): void {
    $exportCanvasButton.disabled = disabled
    $exportCanvasButton.setAttribute('aria-busy', String(isExporting))
  }

  $exportCanvasButton.onclick = async () => {
    if (isExporting) return

    // The empty template hasn't loaded yet: exporting now would give a blank PNG
    if ($canvas.dataset.ready !== 'true') {
      notify({ type: 'info', title: feedback.notReadyTitle, message: feedback.notReadyMessage })
      return
    }

    isExporting = true
    setExportDisabled(true)
    try {
      if ($exportBothSides.checked) {
        await exportZip()
      } else {
        await exportFrontOnly()
      }
      notify({ type: 'success', title: feedback.successTitle, message: feedback.successMessage })
    } catch {
      notify({ type: 'error', title: feedback.errorTitle, message: feedback.errorMessage })
    } finally {
      isExporting = false
      setExportDisabled(!!$flipContainer?.classList.contains('is-flipped'))
    }
  }

  // --- Flip logic ---
  const $flipCard = $<HTMLButtonElement>('#flipCard')

  if ($flipCard && $flipContainer) {
    $flipCard.addEventListener('click', () => {
      const isFlipped = $flipContainer.classList.toggle('is-flipped')
      $flipCard.textContent = isFlipped
        ? ($flipCard.dataset.front ?? '')
        : ($flipCard.dataset.back ?? '')
      $flipCard.setAttribute('aria-pressed', String(isFlipped))
      $exportCanvasButton.title = isFlipped ? ($exportCanvasButton.dataset.flippedHint ?? '') : ''
      if (!isExporting) setExportDisabled(isFlipped)
    })
  }
</script>
