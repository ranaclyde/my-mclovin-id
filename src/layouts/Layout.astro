---
import Footer from '@/sections/Footer.astro'
import Navbar from '@/sections/Navbar.astro'
import type { FullTranslations } from '@/i18n/translations'

interface Props {
  t: FullTranslations
}

const { t } = Astro.props

const site = Astro.site!.toString().replace(/\/$/, '')
const canonicalUrl = t.lang === 'en' ? `${site}/en/` : `${site}/`
const esUrl = `${site}/`
const enUrl = `${site}/en/`
const ogImage = `${site}/images/screenshot.jpg`

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'My McLovin ID',
  url: canonicalUrl,
  description: t.description,
  applicationCategory: 'EntertainmentApplication',
  operatingSystem: 'Web',
  inLanguage: t.lang,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
}
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.description} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <meta name="generator" content={Astro.generator} />
    <title>{t.title}</title>

    <!-- Canonical & hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:site_name" content="My McLovin ID" />
    <meta property="og:locale" content={t.lang === 'en' ? 'en_US' : 'es_ES'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.title} />
    <meta name="twitter:description" content={t.description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-hawaii-navy">
    <Navbar t={t.navbar} />
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  @import 'butterup-toast/dist/butterup.css';

  html {
    scroll-behavior: smooth;
  }

  ::selection {
    background-color: rgba(245, 158, 11, 0.35);
    color: #ffffff;
  }

  input,
  textarea {
    caret-color: #fbbf24;
  }

  /* Hand-rolled controls get the same focus ring as Button */
  :focus-visible {
    outline: 2px solid #fbbf24;
    outline-offset: 2px;
  }

  /* Toasts themed from the hawaii palette */
  .toaster.bottom-center {
    width: calc(100% - 2rem);
    max-width: 360px;
  }

  .butteruptoast.mclovin {
    width: 100%;
    padding: 14px 16px;
    font-size: 14px;
    background-color: #0d1528;
    border: 1px solid #1e3a5f;
    color: #ffffff;
    box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.7);
  }

  .butteruptoast.mclovin .message {
    color: #cbd5e1;
  }

  .butteruptoast.mclovin.success { border-color: rgba(251, 191, 36, 0.5); }
  .butteruptoast.mclovin.success .icon svg { fill: #fbbf24; }
  .butteruptoast.mclovin.warning { border-color: rgba(245, 158, 11, 0.5); }
  .butteruptoast.mclovin.warning .icon svg { fill: #f59e0b; }
  .butteruptoast.mclovin.error { border-color: rgba(248, 113, 113, 0.55); }
  .butteruptoast.mclovin.error .icon svg { fill: #f87171; }
  .butteruptoast.mclovin.info .icon svg { fill: #38bdf8; }

  /* Animaciones on-scroll */
  [data-animate] {
    animation-play-state: paused;
  }

  [data-animate].is-visible {
    animation-play-state: running;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (!('IntersectionObserver' in window)) {
      document.querySelectorAll<HTMLElement>('[data-animate]').forEach((el) => {
        el.classList.add('is-visible')
      })
      return
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible')
            observer.unobserve(entry.target)
          }
        })
      },
      { threshold: 0.15 }
    )

    document.querySelectorAll('[data-animate]').forEach((el) => {
      observer.observe(el)
    })
  })
</script>
