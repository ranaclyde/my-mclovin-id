---
import type { SelectOptions } from '@/types'

interface Props {
  id: string
  label: string
  placeholder?: string
  isRequired?: boolean
  options: SelectOptions[]
  class?: string
}

const {
  id,
  label,
  placeholder = 'Select an option',
  isRequired = false,
  options,
  class: className,
} = Astro.props
---

<div class:list={className}>
  <label for={id} class="block mb-2 text-sm font-medium text-white">
    {label}
  </label>
  <div class="relative">
    <select
      id={id}
      class="block w-full min-w-0 h-12 pl-3 pr-10 appearance-none border text-base md:text-sm rounded-lg bg-hawaii-input border-hawaii-steel text-white cursor-pointer focus:outline-none focus:ring-2 focus:ring-amber-500/40 focus:border-amber-500 hover:border-amber-500 transition-[border-color,box-shadow] duration-150 ease-in-out"
      required={isRequired}
    >
      <option value="" disabled selected>{placeholder}</option>
      {
        options.map((option) => (
          <option value={option.value}>{option.text}</option>
        ))
      }
    </select>
    <svg
      class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</div>

<style>
  select {
    color-scheme: dark;
  }
</style>
