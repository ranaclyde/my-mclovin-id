---
interface Props {
  label: string
}

const { label } = Astro.props
---

<div class="relative w-full max-w-[527px]">
  <div
    class="hidden lg:block w-[527px] h-[326px] bg-amber-400 absolute -z-[1] blur-md opacity-20"
  >
  </div>

  <!-- Perspective wrapper -->
  <div class="flip-perspective">

    <!-- Flip container (recibe .is-flipped via JS) -->
    <div id="flip-container" class="flip-card">

      <!-- Cara frontal -->
      <div class="flip-face">
        <canvas
          id="mclovin-canvas"
          role="img"
          aria-label={label}
          class="w-full h-full lg:w-[527px] lg:h-[326px] rounded-md bg-transparent border border-hawaii-steel"
          width="527"
          height="326"
        ></canvas>
      </div>

      <!-- Cara trasera -->
      <div class="flip-face flip-back">
        <img
          src="/images/mclovin-id-back.webp"
          alt="McLovin ID back"
          class="w-full h-full rounded-md object-cover"
        />
      </div>

    </div>
  </div>

  <img
    hidden
    id="mcLovinID"
    src="/images/mclovin-empty-id.webp"
    alt="Empty McLovin ID"
  />

  <img
    hidden
    id="mcLovinFace"
    src="/images/mclovin-face.webp"
    alt="McLovin Face ID"
  />

  <img
    hidden
    id="mcLovinSign"
    src="/images/mclovin-sign.webp"
    alt="McLovin Sign"
  />
</div>

<style>
  .flip-perspective {
    perspective: 1000px;
    width: 100%;
    aspect-ratio: 527 / 326;
  }

  @media (min-width: 1024px) {
    .flip-perspective {
      width: 527px;
      height: 326px;
      aspect-ratio: auto;
    }
  }

  .flip-card {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 600ms ease-in-out;
  }

  @media (min-width: 1024px) {
    .flip-card {
      width: 527px;
      height: 326px;
    }
  }

  .flip-card.is-flipped {
    transform: rotateY(180deg);
  }

  .flip-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
  }

  .flip-back {
    transform: rotateY(180deg);
  }
</style>

<script>
  import { mclovin, fontSize } from '@/const/mclovinData'
  import { formattedDate } from '@/utils/formattedDate'
  import { $ } from '@/utils/domSelector'

  const $canvas = $<HTMLCanvasElement>('#mclovin-canvas')
  const ctx = $canvas.getContext('2d')!

  const $mcLovinID = $<HTMLImageElement>('#mcLovinID')
  const $mcLovinFace = $<HTMLImageElement>('#mcLovinFace')
  const $mcLovinSign = $<HTMLImageElement>('#mcLovinSign')
  const $name = $<HTMLInputElement>('#name')
  const $dob = $<HTMLInputElement>('#dob')
  const $sex = $<HTMLSelectElement>('#sex')
  const $photo = $<HTMLImageElement>('#croppedImage')
  const $signImage = $<HTMLImageElement>('#signImage')

  // The name sits under the barcode; wider text gets squeezed instead of
  // running into the signature area.
  const NAME_MAX_WIDTH = 185

  $('#form').addEventListener('input', function () {
    drawCanvas()
  })

  // Fired by components that change an image without triggering a load event
  // (e.g. clearing the signature).
  document.addEventListener('mclovin:redraw', () => {
    drawCanvas()
  })

  // Redraw as each image finishes loading, including the base assets, which
  // may still be in flight when this script first runs.
  ;[$mcLovinID, $mcLovinFace, $mcLovinSign, $photo, $signImage].forEach(($img) => {
    $img?.addEventListener('load', () => {
      drawCanvas()
    })
  })

  // drawImage throws on a broken image and draws nothing on a pending one
  function isReady($img: HTMLImageElement | null): $img is HTMLImageElement {
    return !!$img?.getAttribute('src') && $img.complete && $img.naturalWidth > 0
  }

  function drawCanvas() {
    // Clean canvas
    ctx.clearRect(0, 0, $canvas.width, $canvas.height)
    // Draw empty ID
    if (isReady($mcLovinID)) {
      ctx.drawImage($mcLovinID, 0, 0, $canvas.width, $canvas.height)
    }
    $canvas.dataset.ready = String(isReady($mcLovinID))

    // Draw McLovin photo
    const photo = isReady($photo) ? $photo : $mcLovinFace
    if (isReady(photo) && isReady($mcLovinFace)) {
      ctx.drawImage(
        photo,
        mclovin.photo.posX / 3,
        mclovin.photo.posY / 3,
        $mcLovinFace.naturalWidth / 3,
        $mcLovinFace.naturalHeight / 3
      )
    }
    // Draw McLovin sign
    const hasCustomSign = isReady($signImage)
    const sign = hasCustomSign ? $signImage : $mcLovinSign
    const signSize = hasCustomSign ? 3 : 4
    if (isReady(sign) && isReady($mcLovinSign)) {
      ctx.drawImage(
        sign,
        mclovin.sign.posX / 3,
        mclovin.sign.posY / 3,
        $mcLovinSign.naturalWidth / signSize,
        $mcLovinSign.naturalHeight / signSize
      )
    }

    ctx.font = `bold ${fontSize.title / 3}px Arial`
    // DOB
    ctx.fillText(
      formattedDate($dob?.value) || mclovin.dob.value,
      mclovin.dob.posX / 3,
      mclovin.dob.posY / 3
    )
    // EXP
    ctx.fillText(
      updateExpDate() || mclovin.exp.value,
      mclovin.exp.posX / 3,
      mclovin.exp.posY / 3
    )
    // NAME
    ctx.fillText(
      $name?.value.trim() || mclovin.name.value,
      mclovin.name.posX / 3,
      mclovin.name.posY / 3,
      NAME_MAX_WIDTH
    )

    ctx.font = `bold ${fontSize.subtitle / 3}px Arial`
    // SEX
    ctx.fillText(
      $sex?.value || mclovin.sex.value,
      mclovin.sex.posX / 3,
      mclovin.sex.posY / 3
    )
    // ISSUE DATE
    ctx.fillText(
      formattedDate(new Date().toDateString()) || mclovin.issueDate.value,
      mclovin.issueDate.posX / 3,
      mclovin.issueDate.posY / 3
    )
  }

  function isLeapYear(year: number) {
    return (year % 4 === 0 && year % 100 !== 0) || year % 400 === 0
  }

  function updateExpDate() {
    if (!$dob.value) return
    const dobDate = formattedDate($dob.value)
    const extractDate = dobDate?.split('/')
    if (!extractDate) return
    const year = new Date().getFullYear() + 10
    const [month, day] = extractDate
    // A Feb 29 birthday expires on Feb 28 when the expiry year isn't leap
    const expDay = month === '02' && day === '29' && !isLeapYear(year) ? '28' : day
    return `${month}/${expDay}/${year}`
  }

  drawCanvas()
</script>
